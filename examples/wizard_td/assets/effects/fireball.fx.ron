// Fireball: looping, attached to a flying projectile (~18 m/s). A hot core
// sprite with one point light and flickering flames travel with it (local
// space); a tapering fire ribbon (orange -> dark red) and a few embers are
// left behind in world space. No textures or custom materials.
// User parameters:
//   User.Tint  Color  fire colour (default orange (1.0, 0.45, 0.12, 1.0))
(
    name: "Fireball",
    user_parameters: { "User.Tint": Color((1.0, 0.45, 0.12, 1.0)) },
    scalability: (
        max_distance: 90.0,
        bounds_radius: 4.0,
        max_instances: 48,
        quality: (
            Low: (spawn_count_scale: 0.5, max_instances: 16),
            Medium: (spawn_count_scale: 0.75, max_instances: 32),
        ),
    ),
    emitters: [
        (
            name: "Core",
            max_particles: 2,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(1), "Spawn Time": Float(0.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(1000.0),
                    "Color": Link(Color, "User.Tint"),
                    "Sprite Size": Vec2((0.55, 0.55)),
                }),
                (module: "Initialize Light", inputs: { "Light Radius": Float(5.0) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Color", inputs: { "Scale RGB": Vec3((1.8, 1.5, 1.2)) }),
            ],
            renderers: [
                Sprite((blend_mode: Additive)),
                Light((max_lights: 1, intensity: 5000.0)),
            ],
        ),
        (
            name: "Flames",
            local_space: false,
            interpolated_spawning: true,
            max_particles: 48,
            emitter_update: [(module: "Spawn Rate", inputs: { "Spawn Rate": Float(100.0) })],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.12), Float(0.26)),
                    "Position": RandomRange(Vec3((-0.1, -0.1, -0.1)), Vec3((0.1, 0.1, 0.1))),
                    "Color": Link(Color, "User.Tint"),
                    "Sprite Size": RandomRange(Vec2((0.28, 0.28)), Vec2((0.45, 0.45))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Inherit Velocity", inputs: { "Velocity Scale": Float(0.2) }),
                (module: "Add Velocity in Cone", inputs: { "Cone Angle": Float(180.0), "Velocity Strength": RandomRange(Float(0.3), Float(0.9)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Acceleration Force", inputs: { "Acceleration": Vec3((0.0, 2.0, 0.0)) }),
                (module: "Solve Forces and Velocity"),
                (module: "Sprite Rotation Rate", inputs: { "Rotation Rate": Float(180.0) }),
                (module: "Scale Sprite Size", inputs: { "Scale Factor": CurveOverAge(Vec2([(0.0, (0.7, 0.7)), (0.3, (1.0, 1.0)), (1.0, (0.3, 0.3))])) }),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (1.3, 1.1, 0.9)), (0.5, (0.9, 0.5, 0.3)), (1.0, (0.5, 0.15, 0.1))])),
                    "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.15, 0.8), (1.0, 0.0)])),
                }),
            ],
            renderers: [Sprite((blend_mode: Additive))],
        ),
        (
            name: "Trail",
            local_space: false,
            interpolated_spawning: true,
            max_particles: 64,
            emitter_update: [
                (module: "Spawn Per Unit", inputs: { "Spawn Per Unit": Float(7.0), "Movement Tolerance": Float(0.2) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(0.35),
                    "Color": Link(Color, "User.Tint"),
                }),
                (module: "Initialize Ribbon", inputs: { "Ribbon Width": Float(0.4) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Ribbon Width", inputs: { "Ribbon Width Scale": CurveOverAge(Float([(0.0, 1.0), (0.4, 0.6), (1.0, 0.05)])) }),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (1.0, 0.9, 0.7)), (0.35, (0.7, 0.4, 0.25)), (1.0, (0.3, 0.05, 0.03))])),
                    "Scale Alpha": CurveOverAge(Float([(0.0, 0.9), (0.6, 0.6), (1.0, 0.0)])),
                }),
            ],
            renderers: [Ribbon((blend_mode: Additive, tessellation_factor: 2))],
        ),
        (
            name: "Embers",
            local_space: false,
            interpolated_spawning: true,
            max_particles: 32,
            emitter_update: [(module: "Spawn Rate", inputs: { "Spawn Rate": Float(30.0) })],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.4), Float(0.8)),
                    "Position": RandomRange(Vec3((-0.12, -0.12, -0.12)), Vec3((0.12, 0.12, 0.12))),
                    "Color": Link(Color, "User.Tint"),
                    "Sprite Size": RandomRange(Vec2((0.035, 0.035)), Vec2((0.06, 0.06))),
                }),
                (module: "Inherit Velocity", inputs: { "Velocity Scale": Float(0.15) }),
                (module: "Add Velocity in Cone", inputs: { "Cone Angle": Float(180.0), "Velocity Strength": RandomRange(Float(0.8), Float(2.0)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Acceleration Force", inputs: { "Acceleration": Vec3((0.0, 1.5, 0.0)) }),
                (module: "Curl Noise Force", inputs: { "Noise Strength": Float(3.0), "Noise Frequency": Float(1.5) }),
                (module: "Drag", inputs: { "Drag": Float(2.0) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (3.0, 2.4, 2.0)), (1.0, (0.8, 0.3, 0.2))])),
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.7, 0.8), (1.0, 0.0)])),
                }),
            ],
            renderers: [Sprite((blend_mode: Additive))],
        ),
    ],
)
