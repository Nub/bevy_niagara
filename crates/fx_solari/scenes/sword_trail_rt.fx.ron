// fxsolari test scene: the reference sword trail (effects/library/sword_trail.fx.ron)
// with ray tracing on both ribbons: seen in the mirror, lighting the wall.
//
// Sword trail: a bright crescent slash. Particles leave the hilt along the
// swing and a sideways force bends their paths into an arc; the ribbon
// joins them in spawn order, fading from the blade edge to the tail.
//
// Niagara tutorial recipe ("Weapon / sword trail": ribbon emitter):
//  1. Spawn Rate high so the trail has many segments.
//  2. Initialize Particle: short Lifetime (the trail length in time), HDR
//     blue-white Color.
//  3. Initialize Ribbon: Ribbon Width (the blade length), Ribbon Twist
//     to lay the ribbon flat along the swing.
//  4. Add Velocity (the swing direction) and a Gravity Force across it
//     that bends the path into a crescent; a slow, panning Curl Noise Force
//     sways the arc over time (the swing); Drag; Solve Forces and Velocity.
//  5. Scale Color alpha over age (the tutorial's "fade along the trail"
//     step).
//  6. Ribbon renderer: Additive, tessellated for smooth curvature; a thin hot core ribbon on
//     top (second emitter).
// Not available yet: following a moving socket (emitters spawn in the
// effect's local space and particles never inherit a world-space source
// motion), so the swing is shaped by forces instead of the blade's motion,
// and ribbon width over age (width is set at spawn).
(
    name: "Sword Trail",
    emitters: [
        (
            name: "Slash",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(120.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(0.6),
                    "Position": Vec3((-0.9, 1.6, 0.0)),
                    "Color": Color((0.8, 1.6, 4.0, 1.0)),
                }),
                (module: "Initialize Ribbon", inputs: { "Ribbon Width": Float(0.28), "Ribbon Twist": Float(0.0) }),
                (module: "Add Velocity", inputs: { "Velocity": Vec3((5.0, 0.6, 0.0)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Vec3((-7.0, -9.0, 0.0)) }),
                (module: "Curl Noise Force", inputs: {
                    "Noise Strength": Float(8.0),
                    "Noise Frequency": Float(0.25),
                    "Pan Noise Field": Vec3((0.0, 0.0, 0.6)),
                }),
                (module: "Drag", inputs: { "Drag": Float(0.5) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.4, 0.6), (1.0, 0.0)])),
                }),
            ],
            renderers: [Ribbon((blend_mode: Additive, tessellation_factor: 4, ray_tracing: true))],
        ),
        (
            name: "Edge",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(120.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(0.45),
                    "Position": Vec3((-0.9, 1.6, 0.0)),
                    "Color": Color((4.0, 4.5, 6.0, 1.0)),
                }),
                (module: "Initialize Ribbon", inputs: { "Ribbon Width": Float(0.05) }),
                (module: "Add Velocity", inputs: { "Velocity": Vec3((5.0, 0.6, 0.0)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Vec3((-7.0, -9.0, 0.0)) }),
                (module: "Curl Noise Force", inputs: {
                    "Noise Strength": Float(8.0),
                    "Noise Frequency": Float(0.25),
                    "Pan Noise Field": Vec3((0.0, 0.0, 0.6)),
                }),
                (module: "Drag", inputs: { "Drag": Float(0.5) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (1.0, 0.0)])),
                }),
            ],
            renderers: [Ribbon((blend_mode: Additive, tessellation_factor: 4, ray_tracing: true))],
        ),
    ],
)
