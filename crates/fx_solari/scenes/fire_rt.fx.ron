// Ray-tracing test scene (fx_solari): the bench campfire with ray_tracing on.
// Flames (additive, rising through curl noise, cooling yellow -> red -> out)
// plus a few embers drifting up.
// Steady state ~600 flame particles and ~60 embers.
(
    name: "Fire",
    emitters: [
        (
            name: "Flames",
            sim_target: Gpu,
            max_particles: 1024,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(700.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.6), Float(1.1)),
                    "Position": RandomRange(Vec3((-0.25, 0.0, -0.25)), Vec3((0.25, 0.1, 0.25))),
                    "Color": Color((4.0, 2.2, 0.6, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.25, 0.25)), Vec2((0.4, 0.4))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((-0.1, 0.8, -0.1)), Vec3((0.1, 1.4, 0.1))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Vec3((0.0, 1.0, 0.0)) }),
                (module: "Curl Noise Force", inputs: {
                    "Noise Strength": Float(1.2),
                    "Noise Frequency": Float(1.5),
                }),
                (module: "Drag", inputs: { "Drag": Float(1.0) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (1.0, 1.0, 1.0)), (0.5, (1.0, 0.45, 0.15)), (1.0, (0.4, 0.05, 0.0))])),
                    "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.1, 1.0), (1.0, 0.0)])),
                }),
                (module: "Scale Sprite Size", inputs: {
                    "Scale Factor": CurveOverAge(Vec2([(0.0, (0.6, 0.6)), (0.3, (1.0, 1.0)), (1.0, (0.3, 0.3))])),
                }),
            ],
            renderers: [Sprite((blend_mode: Additive, soft_particle_fade_distance: 0.2, ray_tracing: true))],
        ),
        (
            name: "Embers",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(25.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.5), Float(3.0)),
                    "Position": RandomRange(Vec3((-0.3, 0.1, -0.3)), Vec3((0.3, 0.4, 0.3))),
                    "Color": Color((6.0, 2.0, 0.4, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.015, 0.015)), Vec2((0.03, 0.03))),
                }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((-0.2, 1.0, -0.2)), Vec3((0.2, 2.0, 0.2))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Curl Noise Force", inputs: { "Noise Strength": Float(2.0), "Noise Frequency": Float(0.7) }),
                (module: "Drag", inputs: { "Drag": Float(0.6) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.7, 1.0), (1.0, 0.0)])),
                }),
            ],
            renderers: [Sprite((blend_mode: Additive, alignment: VelocityAligned, ray_tracing: true))],
        ),
    ],
)
