// Portal vortex: a round gate of cyan energy standing upright, its inner
// swirl spinning, motes spiralling into the centre, blue mist rolling round
// the rim and a cyan light.
//
// Niagara tutorial recipe: CGHOW, "Create EPIC Portal Gate VFX in UE5
// Niagara", https://www.youtube.com/watch?v=uNU0xCeIL2I (a 25 s showcase of
// the layers: "glowing round gate, dynamic portal energy, misty smoke with
// particles"; steps below follow those layers in order).
//  1. Glowing round gate: one sprite, ring texture (textures/ring.png),
//     facing the portal's normal (CustomFacingVector (0, 0, 1)), HDR cyan,
//     Additive; a burst of one long-lived particle (Particle State keeps it).
//  2. Dynamic portal energy: two swirl sprites (textures/swirl.png), Sprite
//     Rotation Rate in opposite directions, the second smaller and bluer
//     (the tutorial's panner/rotator material, done as sprite rotation).
//  3. Particles: Spawn Rate; Rotate Around Point around the portal axis with
//     a CurveOverAge radius 1.1 m -> 0.1 m, so motes spiral inward and
//     vanish at the centre; Scale Color fades them in and out.
//  4. Misty smoke: alpha-blended puffs (textures/puff.png) slowly orbiting
//     the rim (Rotate Around Point), growing and fading, ViewDepth sorted.
//  5. Light renderer: a cyan point light in front of the gate.
// Gaps: no rotator/panner in the material editor (sprite rotation instead);
// Shape Location has no orientation (Rotate Around Point places the motes).
(
    name: "Portal Vortex",
    emitters: [
        (
            name: "Gate Ring",
            sim_target: Gpu,
            max_particles: 2,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(1) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(1000.0),
                    "Position": Vec3((0.0, 1.3, 0.0)),
                    "Color": Color((0.6, 3.2, 6.0, 1.0)),
                    "Sprite Size": Vec2((2.5, 2.5)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
            ],
            renderers: [Sprite((blend_mode: Additive, facing_mode: CustomFacingVector, custom_facing_vector: (0.0, 0.0, 1.0), texture: "textures/ring.png"))],
        ),
        (
            name: "Energy",
            sim_target: Gpu,
            max_particles: 4,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(1) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(1000.0),
                    "Position": Vec3((0.0, 1.3, 0.0)),
                    "Color": Color((0.3, 1.8, 3.2, 1.0)),
                    "Sprite Size": Vec2((2.3, 2.3)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Sprite Rotation Rate", inputs: { "Rotation Rate": Float(-140.0) }),
            ],
            renderers: [Sprite((blend_mode: Additive, facing_mode: CustomFacingVector, custom_facing_vector: (0.0, 0.0, 1.0), texture: "textures/swirl.png"))],
        ),
        (
            name: "Energy Inner",
            sim_target: Gpu,
            max_particles: 4,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(1) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(1000.0),
                    "Position": Vec3((0.0, 1.3, 0.01)),
                    "Color": Color((0.15, 0.7, 2.6, 1.0)),
                    "Sprite Size": Vec2((1.6, 1.6)),
                    "Sprite Rotation": Float(90.0),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Sprite Rotation Rate", inputs: { "Rotation Rate": Float(-230.0) }),
            ],
            renderers: [Sprite((blend_mode: Additive, facing_mode: CustomFacingVector, custom_facing_vector: (0.0, 0.0, 1.0), texture: "textures/swirl.png"))],
        ),
        (
            name: "Motes",
            sim_target: Gpu,
            max_particles: 256,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(110.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.0), Float(1.6)),
                    "Color": Color((1.2, 4.0, 7.0, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.03, 0.03)), Vec2((0.06, 0.06))),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Rotate Around Point", inputs: {
                    "Rotation Center": Vec3((0.0, 1.3, 0.05)),
                    "Rotation Axis": Vec3((0.0, 0.0, 1.0)),
                    "Rotation Radius": CurveOverAge(Float([(0.0, 1.25), (0.6, 0.7), (1.0, 0.08)])),
                    "Rotation Rate": Float(-200.0),
                    "Phase": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.15, 1.0), (0.8, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive))],
        ),
        (
            name: "Mist",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(24.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(2.0), Float(3.0)),
                    "Color": Color((0.1, 0.45, 0.6, 0.5)),
                    "Sprite Size": RandomRange(Vec2((0.5, 0.5)), Vec2((0.8, 0.8))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Rotate Around Point", inputs: {
                    "Rotation Center": Vec3((0.0, 1.3, -0.05)),
                    "Rotation Axis": Vec3((0.0, 0.0, 1.0)),
                    "Rotation Radius": CurveOverAge(Float([(0.0, 1.15), (1.0, 1.45)])),
                    "Rotation Rate": Float(-35.0),
                    "Phase": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Sprite Rotation Rate", inputs: { "Rotation Rate": Float(20.0) }),
                (module: "Scale Sprite Size", inputs: { "Scale Factor": CurveOverAge(Vec2([(0.0, (0.6, 0.6)), (1.0, (1.4, 1.4))])) }),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.3, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Alpha, sort_mode: ViewDepth, texture: "textures/puff.png"))],
        ),
        (
            name: "Light",
            sim_target: Gpu,
            max_particles: 1,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(1) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: { "Lifetime": Float(1000.0), "Position": Vec3((0.0, 1.3, 0.6)), "Color": Color((0.2, 0.7, 1.0, 1.0)) }),
                (module: "Initialize Light", inputs: { "Light Radius": Float(5.0) }),
            ],
            particle_update: [(module: "Particle State")],
            renderers: [Light((intensity: 60000.0))],
        ),
    ],
)
