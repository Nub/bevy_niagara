// Stylized tornado: stacked, spinning green torus rings climb and widen into
// a funnel, each eroding away as it rises, with sparks spiralling up inside
// and dark dust churning at the base.
//
// Niagara tutorial recipe: CGHOW, "Stylized Tornado in Unreal Engine 5
// Niagara", https://www.youtube.com/watch?v=360__bcB9cM (its thumbnail and
// frames show the tornado; its description is a copy of another video's, so
// no chapter list: steps follow CGHOW's matching written tutorial "Simple
// Stylized Tornado VFX in UE5 Niagara! (Torus Mesh, Erode & Dynamic Params)"
// and the frames: torus mesh, erode material, dynamic parameters, particles):
//  1. Torus mesh: Mesh renderer with the built-in torus, flattened by
//     Initialize Mesh (Mesh Scale Y 0.16), Additive, unlit.
//  2. Erode material: materials/tornado_erode.wesl (panned streak noise cut
//     by a threshold).
//  3. Dynamic Params: Dynamic Material Parameters, x = erode threshold as a
//     CurveOverAge 0.15 -> 0.95, so each ring frays as it climbs.
//  4. Emitter: Spawn Rate 34; Initialize Particle at the base; Add Velocity
//     up (1.6 m/s); Scale Mesh Size over age (0.2 -> 2.6: the funnel
//     widens with height); Update Mesh Orientation spins it (Y 420 deg/s);
//     Curl Noise Force for the lean and wobble.
//  5. Sparks: Shape Location Cylinder, Add Velocity up, Vortex Force (with a
//     small outward Origin Pull so the spiral widens), Acceleration up, Drag.
//  6. Base dust: alpha puffs on a Ring, Vortex Force + Drag, growing, fading.
// Gaps: no custom torus mesh with the tutorial's UV layout (built-in
// torus); no Texture Sample in materials of a noise asset (noise is computed).
(
    name: "Stylized Tornado",
    emitters: [
        (
            name: "Funnel",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(34.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(2.2),
                    "Position": Vec3((0.0, 0.05, 0.0)),
                    "Color": Color((0.25, 1.6, 0.4, 1.0)),
                }),
                (module: "Initialize Mesh", inputs: {
                    "Mesh Scale": Vec3((1.0, 0.16, 1.0)),
                    "Mesh Rotation": RandomRange(Vec3((-4.0, 0.0, -4.0)), Vec3((4.0, 360.0, 4.0))),
                }),
                (module: "Add Velocity", inputs: { "Velocity": Vec3((0.0, 1.6, 0.0)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Curl Noise Force", inputs: { "Noise Strength": Float(0.6), "Noise Frequency": Float(0.4), "Pan Noise Field": Vec3((0.0, -0.3, 0.0)) }),
                (module: "Solve Forces and Velocity"),
                (module: "Update Mesh Orientation", inputs: { "Rotation Rate": Vec3((0.0, 420.0, 0.0)) }),
                (module: "Scale Mesh Size", inputs: { "Scale Factor": CurveOverAge(Vec3([(0.0, (0.2, 0.2, 0.2)), (0.4, (0.7, 0.7, 0.7)), (1.0, (2.6, 2.0, 2.6))])) }),
                (module: "Dynamic Material Parameters", inputs: { "Dynamic Material Parameter": CurveOverAge(Vec4([(0.0, (0.15, 0.0, 0.0, 0.0)), (0.6, (0.4, 0.0, 0.0, 0.0)), (1.0, (0.95, 0.0, 0.0, 0.0))])) }),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.15, 0.8), (0.8, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Mesh((mesh: "torus", blend_mode: Additive, lit: false, material: "materials/tornado_erode.wesl"))],
        ),
        (
            name: "Sparks",
            sim_target: Gpu,
            max_particles: 512,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(120.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.2), Float(2.0)),
                    "Color": Color((1.0, 5.0, 1.2, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.025, 0.025)), Vec2((0.05, 0.05))),
                }),
                (module: "Shape Location", inputs: { "Shape Primitive": Cylinder, "Cylinder Height": Float(0.3), "Cylinder Radius": Float(0.3), "Offset": Vec3((0.0, 0.2, 0.0)) }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((0.0, 1.4, 0.0)), Vec3((0.0, 2.2, 0.0))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Vortex Force", inputs: { "Vortex Force Amount": Float(9.0), "Origin Pull Amount": Float(-0.6) }),
                (module: "Acceleration Force", inputs: { "Acceleration": Vec3((0.0, 2.0, 0.0)) }),
                (module: "Drag", inputs: { "Drag": Float(1.4) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.1, 1.0), (0.7, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive))],
        ),
        (
            name: "Base Dust",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(30.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.5), Float(2.5)),
                    "Color": Color((0.05, 0.12, 0.06, 0.6)),
                    "Sprite Size": RandomRange(Vec2((0.4, 0.4)), Vec2((0.7, 0.7))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Shape Location", inputs: { "Shape Primitive": Ring, "Ring Radius": Float(0.45), "Disc Coverage": Float(0.5), "Offset": Vec3((0.0, 0.1, 0.0)) }),
                (module: "Add Velocity", inputs: { "Velocity": Vec3((0.0, 0.15, 0.0)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Vortex Force", inputs: { "Vortex Force Amount": Float(3.0), "Origin Pull Amount": Float(0.5) }),
                (module: "Drag", inputs: { "Drag": Float(1.5) }),
                (module: "Solve Forces and Velocity"),
                (module: "Sprite Rotation Rate", inputs: { "Rotation Rate": Float(60.0) }),
                (module: "Scale Sprite Size", inputs: { "Scale Factor": CurveOverAge(Vec2([(0.0, (0.6, 0.6)), (1.0, (1.6, 1.6))])) }),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.2, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Alpha, sort_mode: ViewDepth, texture: "textures/puff.png"))],
        ),
    ],
)
