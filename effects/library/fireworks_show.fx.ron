// Fireworks show: rockets launch every half second from along a 8 m line,
// trailing sparks; each bursts into a sphere of flare-textured stars in a
// colour set by where it went up, with a flash, and the stars shed
// glittering sparkles as they droop and fade.
//
// Niagara tutorial recipe: Enrique Ventura, "Unreal 5.3 - Advanced Niagara
// fireworks - Chapter 3: Explosions!", https://www.youtube.com/watch?v=PA9sQV8uI8g
// (the series' rocket and trail chapters before it set up steps 1-2).
// Textures: the tutorial's own Flare1-4 (linked in its description; fetched
// by testdata/tutorial_assets.sh into testdata/tutorial_assets/fireworks,
// never committed; without them the built-in soft sprite is drawn).
//  1. Rockets: Emitter State + Spawn Burst Interval (one rocket every 0.5 s),
//     random launch point along X, Add Velocity up, Gravity Force, Solve.
//     Generate Location Event (trail) and Generate Death Event (explosion).
//  2. Rocket trail: event handler on Location events, 2 particles each,
//     Receive Location Event (inheriting a little velocity), fading sparks.
//  3. Explosion: event handler on Death events, Spawned Particles 200;
//     Receive Death Event; Add Velocity in Cone 180 deg (a sphere), Drag,
//     light gravity: the stars hang, then droop. Flare1 texture.
//  4. Colour per explosion: the tutorial randomises a colour per rocket and
//     passes it on. Events here carry position/velocity/ID only, so the
//     colour comes from the event's X position through a banded colour
//     curve (Color from Curve, Break Vec3).
//  5. Fade: Scale Color brightness and alpha over age.
//  6. Flash: a second Death handler spawns one big Flare4 sprite, 0.15 s.
//  7. Glitter: stars Generate Location Event (probability 0.2); a Glitter
//     emitter spawns gold Flare2 twinkles there that flicker out.
// Gaps: events carry no user payload (colour), so per-rocket colour is
// derived from the burst position.
(
    name: "Fireworks Show",
    emitters: [
        (
            name: "Rockets",
            sim_target: Gpu,
            max_particles: 16,
            emitter_update: [
                (module: "Spawn Burst Interval", inputs: { "Spawn Count": Int(1), "Spawn Interval": Float(0.5) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.0), Float(1.3)),
                    "Position": RandomRange(Vec3((-4.0, 0.0, -1.0)), Vec3((4.0, 0.0, 1.0))),
                    "Color": Color((3.0, 2.2, 1.2, 1.0)),
                    "Sprite Size": Vec2((0.08, 0.08)),
                }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((-1.0, 11.0, -0.5)), Vec3((1.0, 13.0, 0.5))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force"),
                (module: "Solve Forces and Velocity"),
                (module: "Generate Location Event", inputs: { "Event Probability": Float(0.8) }),
                (module: "Generate Death Event"),
            ],
            renderers: [Sprite((blend_mode: Additive, texture: "tutorial_assets/fireworks/Flare2.png"))],
        ),
        (
            name: "Rocket Trail",
            sim_target: Gpu,
            max_particles: 600,
            event_handlers: [
                (source: "Rockets", event: Location, spawn_number: 2, modules: [
                    (module: "Receive Location Event", inputs: { "Inherit Velocity Scale": Float(0.1) }),
                ]),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.3), Float(0.6)),
                    "Color": Color((2.5, 1.2, 0.4, 1.0)),
                    "Sprite Size": Vec2((0.25, 0.25)),
                }),
                (module: "Add Velocity in Cone", inputs: { "Cone Angle": Float(180.0), "Velocity Strength": RandomRange(Float(0.1), Float(0.4)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Vec3((0.0, -2.0, 0.0)) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive, texture: "tutorial_assets/fireworks/Flare1.png"))],
        ),
        (
            name: "Stars",
            sim_target: Gpu,
            max_particles: 2400,
            event_handlers: [
                (source: "Rockets", event: Death, spawn_number: 200, modules: [
                    (module: "Initialize Particle", inputs: {
                        "Lifetime": RandomRange(Float(1.4), Float(2.0)),
                        "Sprite Size": RandomRange(Vec2((0.4, 0.4)), Vec2((0.6, 0.6))),
                        "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                        "Color": Dynamic("Color from Curve", {
                            "Curve": Color([
                                (0.0, (7.0, 0.8, 0.5, 1.0)), (0.19, (7.0, 0.8, 0.5, 1.0)),
                                (0.2, (6.0, 3.6, 0.6, 1.0)), (0.39, (6.0, 3.6, 0.6, 1.0)),
                                (0.4, (1.0, 5.0, 1.2, 1.0)), (0.59, (1.0, 5.0, 1.2, 1.0)),
                                (0.6, (0.8, 2.2, 7.0, 1.0)), (0.79, (0.8, 2.2, 7.0, 1.0)),
                                (0.8, (5.0, 1.0, 6.0, 1.0)), (1.0, (5.0, 1.0, 6.0, 1.0)),
                            ]),
                            "Curve Index": Dynamic("Add Float", {
                                "A": Dynamic("Multiply Float", {
                                    "A": Dynamic("Break Vec3", { "Value": Link(Vec3, "Event.Position"), "Component": X }),
                                    "B": Float(0.125),
                                }),
                                "B": Float(0.5),
                            }),
                        }),
                    }),
                    (module: "Receive Death Event", inputs: { "Inherit Velocity Scale": Float(0.2) }),
                ]),
            ],
            particle_spawn: [
                (module: "Add Velocity in Cone", inputs: { "Cone Angle": Float(180.0), "Velocity Strength": RandomRange(Float(3.6), Float(4.2)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Vec3((0.0, -2.5, 0.0)) }),
                (module: "Drag", inputs: { "Drag": Float(1.3) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (1.6, 1.6, 1.6)), (0.3, (1.0, 1.0, 1.0)), (1.0, (0.6, 0.45, 0.35))])),
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.7, 0.8), (1.0, 0.0)])),
                }),
                (module: "Generate Location Event", inputs: { "Event Probability": Float(0.2) }),
            ],
            renderers: [Sprite((blend_mode: Additive, texture: "tutorial_assets/fireworks/Flare1.png"))],
        ),
        (
            name: "Flash",
            sim_target: Gpu,
            max_particles: 16,
            event_handlers: [
                (source: "Rockets", event: Death, spawn_number: 1, modules: [
                    (module: "Receive Death Event"),
                ]),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: { "Lifetime": Float(0.15), "Color": Color((4.0, 3.5, 3.0, 1.0)), "Sprite Size": Vec2((2.2, 2.2)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive, texture: "tutorial_assets/fireworks/Flare4.png"))],
        ),
        (
            name: "Glitter",
            sim_target: Gpu,
            max_particles: 4096,
            event_handlers: [
                (source: "Stars", event: Location, spawn_number: 1, modules: [
                    (module: "Receive Location Event"),
                ]),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.25), Float(0.6)),
                    "Color": Color((5.0, 4.0, 2.0, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.3, 0.3)), Vec2((0.5, 0.5))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Vec3((0.0, -1.5, 0.0)) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.25, 0.1), (0.5, 0.9), (0.75, 0.1), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive, texture: "tutorial_assets/fireworks/Flare2.png"))],
        ),
    ],
)
