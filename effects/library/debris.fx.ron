// Debris: an explosion throws lit rock chunks up and out; they tumble
// and fall under gravity until their lifetime ends, with a puff of dust at the blast.
// Fires every two seconds.
//
// Niagara tutorial recipe ("Mesh particles / explosion debris": Simple
// Sprite Burst template switched to a Mesh renderer):
//  1. Spawn Burst Instantaneous in Emitter Update.
//  2. Initialize Particle: random Lifetime, small box spawn, earthy Color
//     (RandomRange on a Color varies each channel independently, which
//     tints chunks, so the colour is fixed).
//  3. Initialize Mesh: random non-uniform Mesh Scale and random Mesh
//     Rotation (the tutorial's "Initial Mesh Orientation" step).
//  4. Add Velocity in Cone (upward, wide), Gravity Force, Drag, Solve Forces
//     and Velocity.
//  5. Update Mesh Orientation with a Rotation Rate (tumbling).
//  6. Mesh renderer: built-in cube, Opaque, lit.
//  7. Dust emitter: alpha, lit, sorted sprites puffing out of the blast.
// Not available yet: Collision (chunks do not bounce on the floor; they are
// killed by lifetime) and emitter looping (bursts listed at 0, 2, 4, 6, 8 s).
(
    name: "Debris",
    emitters: [
        (
            name: "Chunks",
            sim_target: Gpu,
            max_particles: 256,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(80), "Spawn Time": Float(0.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(80), "Spawn Time": Float(2.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(80), "Spawn Time": Float(4.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(80), "Spawn Time": Float(6.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(80), "Spawn Time": Float(8.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.4), Float(1.9)),
                    "Position": RandomRange(Vec3((-0.2, 0.1, -0.2)), Vec3((0.2, 0.3, 0.2))),
                    "Color": Color((0.36, 0.29, 0.22, 1.0)),
                }),
                (module: "Initialize Mesh", inputs: {
                    "Mesh Scale": RandomRange(Vec3((0.05, 0.04, 0.05)), Vec3((0.16, 0.12, 0.16))),
                    "Mesh Rotation": RandomRange(Vec3((0.0, 0.0, 0.0)), Vec3((360.0, 360.0, 360.0))),
                }),
                (module: "Add Velocity in Cone", inputs: {
                    "Cone Axis": Vec3((0.0, 1.0, 0.0)),
                    "Cone Angle": Float(50.0),
                    "Velocity Strength": RandomRange(Float(3.0), Float(6.0)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force"),
                (module: "Drag", inputs: { "Drag": Float(0.3) }),
                (module: "Solve Forces and Velocity"),
                (module: "Update Mesh Orientation", inputs: { "Rotation Rate": Vec3((300.0, 120.0, 210.0)) }),
            ],
            renderers: [Mesh((mesh: "cube", blend_mode: Opaque, lit: true))],
        ),
        (
            name: "Dust",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(24), "Spawn Time": Float(0.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(24), "Spawn Time": Float(2.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(24), "Spawn Time": Float(4.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(24), "Spawn Time": Float(6.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(24), "Spawn Time": Float(8.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.2), Float(1.8)),
                    "Position": RandomRange(Vec3((-0.2, 0.05, -0.2)), Vec3((0.2, 0.25, 0.2))),
                    "Color": Color((0.45, 0.4, 0.34, 0.6)),
                    "Sprite Size": RandomRange(Vec2((0.35, 0.35)), Vec2((0.6, 0.6))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Add Velocity in Cone", inputs: {
                    "Cone Axis": Vec3((0.0, 1.0, 0.0)),
                    "Cone Angle": Float(70.0),
                    "Velocity Strength": RandomRange(Float(0.8), Float(1.8)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Drag", inputs: { "Drag": Float(2.0) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Sprite Size", inputs: {
                    "Scale Factor": CurveOverAge(Vec2([(0.0, (0.6, 0.6)), (1.0, (2.2, 2.2))])),
                }),
                (module: "Scale Color", inputs: {
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (1.0, 0.0)])),
                }),
            ],
            renderers: [Sprite((blend_mode: Alpha, lit: true, sort_mode: ViewDepth, soft_particle_fade_distance: 0.3))],
        ),
    ],
)
