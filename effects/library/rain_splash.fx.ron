// Rain with splashes: thin streaks fall over a 6 m square and, where they hit
// the ground, burst into tiny droplets and a short ripple ring.
//
// Niagara tutorial recipe: Matt Aspland, "How To Create Rain Splashback
// Particles" (UE4 Niagara), https://www.youtube.com/watch?v=QgEKhdV0xrA,
// which extends his rain system (https://youtu.be/s_UQYuM1RWU):
//  1. Rain (base video): Spawn Rate (high), Box Location above the area ->
//     Shape Location Box 6 x 0.5 x 6 m at 6 m; Add Velocity down (9-11 m/s);
//     long thin Sprite Size, Velocity Aligned sprites, white, low alpha.
//  2. 00:49 Rain emitter: add Collision (plane: the floor), response Kill
//     (the drop is consumed by the splash) and Generate Collision Event.
//  3. Splash emitter: an Event Handler on the rain's Collision events,
//     Spawned Particles (4 per event); Receive Collision Event puts them at
//     the hit point.
//  4. Splash particles: Add Velocity in Cone (upward, wide), Gravity Force,
//     short Lifetime, small white sprites, alpha fade.
//  5. (extra layer seen in the final overview) Ripple: one ground-facing
//     ring sprite per hit that grows and fades.
// Gaps: none.
(
    name: "Rain Splash",
    emitters: [
        (
            name: "Rain",
            sim_target: Gpu,
            max_particles: 2048,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(900.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(2.0),
                    "Color": Color((0.8, 0.85, 1.0, 0.45)),
                    "Sprite Size": Vec2((0.012, 0.45)),
                }),
                (module: "Shape Location", inputs: { "Shape Primitive": Box, "Box Size": Vec3((6.0, 0.5, 6.0)), "Offset": Vec3((0.0, 6.0, 0.0)) }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((0.6, -11.0, 0.0)), Vec3((0.8, -9.0, 0.0))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Solve Forces and Velocity"),
                (module: "Collision", inputs: { "Collision Type": Plane, "Collision Response": Kill }),
                (module: "Generate Collision Event"),
            ],
            renderers: [Sprite((blend_mode: Additive, alignment: VelocityAligned, texture: "textures/streak.png"))],
        ),
        (
            name: "Splash",
            sim_target: Gpu,
            max_particles: 2048,
            event_handlers: [
                (source: "Rain", event: Collision, spawn_number: 4, modules: [
                    (module: "Receive Collision Event", inputs: { "Position Offset": Vec3((0.0, 0.01, 0.0)) }),
                ]),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.2), Float(0.35)),
                    "Color": Color((0.9, 0.95, 1.0, 0.8)),
                    "Sprite Size": RandomRange(Vec2((0.012, 0.012)), Vec2((0.022, 0.022))),
                }),
                (module: "Add Velocity in Cone", inputs: { "Cone Angle": Float(55.0), "Velocity Strength": RandomRange(Float(0.8), Float(1.6)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force"),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive))],
        ),
        (
            name: "Ripple",
            sim_target: Gpu,
            max_particles: 1024,
            event_handlers: [
                (source: "Rain", event: Collision, spawn_number: 1, modules: [
                    (module: "Receive Collision Event", inputs: { "Position Offset": Vec3((0.0, 0.005, 0.0)) }),
                ]),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(0.35),
                    "Color": Color((0.6, 0.65, 0.8, 0.5)),
                    "Sprite Size": Vec2((0.16, 0.16)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Sprite Size", inputs: { "Scale Factor": CurveOverAge(Vec2([(0.0, (0.2, 0.2)), (1.0, (1.0, 1.0))])) }),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive, facing_mode: CustomFacingVector, custom_facing_vector: (0.0, 1.0, 0.0), texture: "textures/ring.png"))],
        ),
    ],
)
