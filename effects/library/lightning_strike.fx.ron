// Lightning strike: a jagged blue-white bolt with a dark stylized outline
// strikes the ground, flickers and is gone, with a violet impact glow and
// sparks. A new bolt (new shape) every 0.8 s.
//
// Niagara tutorial recipe: CGHOW, "From Concept to VFX: Stylized Lightning in
// Unreal Engine 5 Niagara", https://www.youtube.com/watch?v=NwdUdaotzNA
//  1. 01:03-04:08 Tiling lightning texture, channel-packed core and glow
//     -> materials/lightning_bolt.wesl draws core + glow procedurally.
//  2. 04:44 Lightning material (glow multiplier, UV scaling) -> same wesl.
//  3. 06:52 Niagara Dynamic Beam (Beam Emitter Setup: start, end, beam width,
//     jagged beam via ribbon particles) -> Emitter State 0.8 s loops + Spawn
//     Burst Instantaneous (32 beam points), custom module "Beam Points"
//     (beam start/end, fractal offsets: the beam's jaggedness), Initialize
//     Ribbon (width), Ribbon renderer Additive, SpawnOrder links.
//  4. 08:33 Stylized dark outlines -> a second ribbon emitter "Outline" with
//     materials/lightning_outline.wesl, Alpha, wider. Camera offset (to put
//     the outline behind) is not available for ribbons: the outline relies on
//     draw order instead.
//  5. 11:52 Linking emitters / synchronising randomness -> both emitters run
//     "Beam Points" with the same Seed; the shape is a hash of the strike
//     number (Emitter.LoopCount-like EmitterAge / 0.8), not a random draw.
//  6. 12:42 UV pinching for tapered ends -> sin(pi * u) in both materials.
//  7. (thumbnail's impact) Impact glow: ground-facing additive flare; Sparks:
//     burst, Add Velocity in Cone, gravity, velocity-aligned streaks.
// Gaps: no Beam Emitter Setup module (custom WGSL module instead); no
// camera offset on ribbons.
(
    name: "Lightning Strike",
    custom_modules: [
        (
            name: "Beam Points",
            inputs: {
                "BeamStart": Vec3((0.25, 3.4, 0.0)),
                "BeamEnd": Vec3((0.0, 0.0, 0.0)),
                "Points": Float(32.0),
                "Amplitude": Float(0.6),
                "StrikeInterval": Float(0.8),
                "Seed": Float(11.0),
            },
            outputs: ["Particles.Position"],
            wgsl: r#"
    let n = max(Points, 2.0);
    let t = f32(u32(UniqueID) % u32(n)) / (n - 1.0);
    let k = floor(EmitterAge / StrikeInterval + 0.01);
    var off = vec2<f32>(0.0, 0.0);
    var amp = 1.0;
    var freq = 2.5;
    for (var o = 0u; o < 4u; o = o + 1u) {
        let x = t * freq + k * 7.31 + Seed + f32(o) * 3.7;
        let i0 = floor(x);
        let fr = x - i0;
        let i = u32(i0);
        let ax = to_unit(pcg(i * 2u + o * 7919u));
        let bx = to_unit(pcg((i + 1u) * 2u + o * 7919u));
        let az = to_unit(pcg(i * 2u + 1u + o * 7919u));
        let bz = to_unit(pcg((i + 1u) * 2u + 1u + o * 7919u));
        off += (vec2<f32>(mix(ax, bx, fr), mix(az, bz, fr)) * 2.0 - 1.0) * amp;
        amp = amp * 0.5;
        freq = freq * 2.3;
    }
    let pinch = sin(t * 3.14159265);
    Position = mix(BeamStart, BeamEnd, t) + vec3<f32>(off.x, 0.0, off.y * 0.4) * Amplitude * pinch;
"#,
        ),
    ],
    emitters: [
        (
            name: "Outline",
            sim_target: Gpu,
            max_particles: 64,
            emitter_update: [
                (module: "Emitter State", inputs: { "Loop Behavior": Infinite, "Loop Duration": Float(0.8) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(32) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: { "Lifetime": Float(0.32), "Color": Color((0.02, 0.0, 0.08, 0.9)) }),
                (module: "Beam Points"),
                (module: "Initialize Ribbon", inputs: { "Ribbon Width": Float(1.0) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.2, 0.4), (0.35, 1.0), (0.6, 0.3), (0.7, 0.9), (1.0, 0.0)])) }),
            ],
            renderers: [Ribbon((blend_mode: Alpha, material: "materials/lightning_outline.wesl"))],
        ),
        (
            name: "Core",
            sim_target: Gpu,
            max_particles: 64,
            emitter_update: [
                (module: "Emitter State", inputs: { "Loop Behavior": Infinite, "Loop Duration": Float(0.8) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(32) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: { "Lifetime": Float(0.32), "Color": Color((0.4, 1.8, 9.0, 1.0)) }),
                (module: "Beam Points"),
                (module: "Initialize Ribbon", inputs: { "Ribbon Width": Float(0.8) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.2, 0.4), (0.35, 1.0), (0.6, 0.3), (0.7, 0.9), (1.0, 0.0)])) }),
            ],
            renderers: [Ribbon((blend_mode: Additive, material: "materials/lightning_bolt.wesl"))],
        ),
        (
            name: "Impact Glow",
            sim_target: Gpu,
            max_particles: 4,
            emitter_update: [
                (module: "Emitter State", inputs: { "Loop Behavior": Infinite, "Loop Duration": Float(0.8) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(1) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(0.5),
                    "Position": Vec3((0.0, 0.02, 0.0)),
                    "Color": Color((2.2, 0.6, 6.0, 1.0)),
                    "Sprite Size": Vec2((1.5, 1.5)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Sprite Size", inputs: { "Scale Factor": CurveOverAge(Vec2([(0.0, (0.5, 0.5)), (0.3, (1.0, 1.0)), (1.0, (1.2, 1.2))])) }),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.3, 0.8), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive, facing_mode: CustomFacingVector, custom_facing_vector: (0.0, 1.0, 0.0), texture: "textures/flare.png"))],
        ),
        (
            name: "Sparks",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Emitter State", inputs: { "Loop Behavior": Infinite, "Loop Duration": Float(0.8) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(40) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.25), Float(0.55)),
                    "Position": Vec3((0.0, 0.05, 0.0)),
                    "Color": Color((1.5, 2.5, 8.0, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.015, 0.06)), Vec2((0.025, 0.14))),
                }),
                (module: "Add Velocity in Cone", inputs: { "Cone Angle": Float(70.0), "Velocity Strength": RandomRange(Float(1.5), Float(4.0)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force"),
                (module: "Drag", inputs: { "Drag": Float(1.5) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((blend_mode: Additive, alignment: VelocityAligned, texture: "textures/streak.png"))],
        ),
    ],
)
