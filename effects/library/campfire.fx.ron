// Campfire: additive flames, glowing embers, a thin smoke column and a
// flickering fire light.
//
// Niagara tutorial recipe ("Create a fire effect": Fountain template turned
// into a flame, then embers, smoke and a light added as extra emitters):
//  1. Flames: Spawn Rate; Initialize Particle (short random Lifetime, small
//     box spawn standing in for Shape Location's cylinder, HDR orange Color,
//     random Sprite Size and Sprite Rotation).
//  2. Add Velocity upward; Gravity Force set positive (buoyancy) instead of
//     the template's downward gravity; Curl Noise Force for the licking motion;
//     Drag; Solve Forces and Velocity.
//  3. Scale Color over age (yellow -> red -> out) and Scale Sprite Size over
//     age (grow then shrink), the tutorial's "Color from curve" and
//     "Scale Sprite Size" steps; Sprite renderer Additive with soft particles.
//  4. Embers emitter: duplicated flame emitter, fewer, smaller, longer-lived,
//     more noise, Velocity Aligned sprites.
//  5. Smoke emitter: Alpha-blended, lit, ViewDepth-sorted sprites that grow
//     and fade (the tutorial's smoke-above-the-fire step).
//  6. Light emitter: a few particles with Initialize Light and a Light
//     renderer, the tutorial's "Light Renderer" flicker step.
// Not available yet: a SubUV flipbook texture (flames use the built-in soft
// sprite).
(
    name: "Campfire",
    emitters: [
        (
            name: "Flames",
            sim_target: Gpu,
            max_particles: 768,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(520.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.5), Float(1.0)),
                    "Position": RandomRange(Vec3((-0.22, 0.0, -0.22)), Vec3((0.22, 0.08, 0.22))),
                    "Color": RandomRange(Color((3.5, 1.6, 0.4, 1.0)), Color((4.5, 2.4, 0.7, 1.0))),
                    "Sprite Size": RandomRange(Vec2((0.22, 0.22)), Vec2((0.38, 0.38))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((-0.1, 0.7, -0.1)), Vec3((0.1, 1.3, 0.1))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Vec3((0.0, 1.2, 0.0)) }),
                (module: "Curl Noise Force", inputs: {
                    "Noise Strength": Float(1.4),
                    "Noise Frequency": Float(1.6),
                    "Pan Noise Field": Vec3((0.0, -1.5, 0.0)),
                }),
                (module: "Drag", inputs: { "Drag": Float(1.2) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (1.0, 1.0, 1.0)), (0.45, (1.0, 0.45, 0.15)), (1.0, (0.35, 0.04, 0.0))])),
                    "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.1, 1.0), (0.7, 0.6), (1.0, 0.0)])),
                }),
                (module: "Scale Sprite Size", inputs: {
                    "Scale Factor": CurveOverAge(Vec2([(0.0, (0.6, 0.6)), (0.3, (1.0, 1.1)), (1.0, (0.25, 0.35))])),
                }),
            ],
            renderers: [Sprite((blend_mode: Additive, soft_particle_fade_distance: 0.2))],
        ),
        (
            name: "Embers",
            sim_target: Gpu,
            max_particles: 128,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(30.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.5), Float(3.0)),
                    "Position": RandomRange(Vec3((-0.25, 0.1, -0.25)), Vec3((0.25, 0.4, 0.25))),
                    "Color": Color((6.0, 2.0, 0.4, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.012, 0.03)), Vec2((0.02, 0.05))),
                }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((-0.2, 1.0, -0.2)), Vec3((0.2, 2.0, 0.2))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Curl Noise Force", inputs: { "Noise Strength": Float(2.5), "Noise Frequency": Float(0.7) }),
                (module: "Drag", inputs: { "Drag": Float(0.6) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (1.0, 1.0, 1.0)), (1.0, (0.6, 0.2, 0.05))])),
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.7, 1.0), (1.0, 0.0)])),
                }),
            ],
            renderers: [Sprite((blend_mode: Additive, alignment: VelocityAligned))],
        ),
        (
            name: "Smoke",
            sim_target: Gpu,
            max_particles: 96,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(16.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(3.0), Float(4.5)),
                    "Position": RandomRange(Vec3((-0.1, 0.7, -0.1)), Vec3((0.1, 0.9, 0.1))),
                    "Color": Color((0.12, 0.11, 0.1, 0.45)),
                    "Sprite Size": RandomRange(Vec2((0.3, 0.3)), Vec2((0.45, 0.45))),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Add Velocity", inputs: { "Velocity": RandomRange(Vec3((-0.05, 0.5, -0.05)), Vec3((0.05, 0.8, 0.05))) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Curl Noise Force", inputs: {
                    "Noise Strength": Float(0.6),
                    "Noise Frequency": Float(0.6),
                    "Pan Noise Field": Vec3((0.0, -0.3, 0.0)),
                }),
                (module: "Drag", inputs: { "Drag": Float(0.4) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Sprite Size", inputs: {
                    "Scale Factor": CurveOverAge(Vec2([(0.0, (0.6, 0.6)), (1.0, (3.0, 3.0))])),
                }),
                (module: "Scale Color", inputs: {
                    "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.2, 1.0), (1.0, 0.0)])),
                }),
            ],
            renderers: [Sprite((blend_mode: Alpha, lit: true, sort_mode: ViewDepth, soft_particle_fade_distance: 0.4))],
        ),
        (
            name: "Fire Light",
            sim_target: Gpu,
            max_particles: 8,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(12.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.2), Float(0.4)),
                    "Position": RandomRange(Vec3((-0.1, 0.3, -0.1)), Vec3((0.1, 0.5, 0.1))),
                    "Color": RandomRange(Color((1.0, 0.45, 0.12, 1.0)), Color((1.0, 0.6, 0.2, 1.0))),
                }),
                (module: "Initialize Light", inputs: { "Light Radius": RandomRange(Float(2.5), Float(3.5)) }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Scale Color", inputs: {
                    "Scale Alpha": CurveOverAge(Float([(0.0, 0.3), (0.5, 1.0), (1.0, 0.3)])),
                }),
            ],
            renderers: [Light((max_lights: 4, intensity: 4000.0))],
        ),
    ],
)
