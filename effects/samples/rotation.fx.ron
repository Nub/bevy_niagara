// Rotation: left, sprites showing one flipbook frame each (the clock-wedge
// test texture) spin at random rates (Sprite Rotation Rate); right, cubes
// start at random orientations (Initial Mesh Orientation), tumble (Update
// Mesh Orientation) and grow then shrink (Scale Mesh Size).
(
    name: "Rotation",
    emitters: [
        (
            name: "Spinning Sprites",
            max_particles: 200,
            emitter_update: [(module: "Spawn Rate", inputs: { "Spawn Rate": Float(12.0) })],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(4.0),
                    "Sprite Size": Vec2((0.35, 0.35)),
                    "Sprite Rotation": RandomRange(Float(0.0), Float(360.0)),
                }),
                (module: "Shape Location", inputs: {
                    "Shape Primitive": Box, "Box Size": Vec3((1.8, 1.6, 0.4)), "Offset": Vec3((-1.3, 1.3, 0.0)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Sprite Rotation Rate", inputs: { "Rotation Rate": RandomRange(Float(-180.0), Float(180.0)) }),
                (module: "SubUV Animation", inputs: { "SubUV Animation Mode": Random, "Number of Frames": Int(8), "Start Frame": Int(4) }),
                (module: "Scale Color", inputs: { "Scale Alpha": CurveOverAge(Float([(0.0, 0.0), (0.1, 1.0), (0.9, 1.0), (1.0, 0.0)])) }),
            ],
            renderers: [Sprite((sub_image_size: (4, 4), texture: "materials/flipbook_4x4.png", sort_mode: ViewDepth))],
        ),
        (
            name: "Tumbling Cubes",
            max_particles: 200,
            emitter_update: [(module: "Spawn Rate", inputs: { "Spawn Rate": Float(8.0) })],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(4.0),
                    "Color": RandomRange(Color((0.5, 0.6, 0.9, 1.0)), Color((0.9, 0.9, 1.0, 1.0))),
                }),
                (module: "Shape Location", inputs: {
                    "Shape Primitive": Box, "Box Size": Vec3((1.6, 1.4, 0.4)), "Offset": Vec3((1.3, 1.3, 0.0)),
                }),
                (module: "Initialize Mesh", inputs: { "Mesh Scale": Vec3((0.25, 0.25, 0.25)) }),
                (module: "Initial Mesh Orientation", inputs: {
                    "Rotation": RandomRange(Vec3((0.0, 0.0, 0.0)), Vec3((360.0, 360.0, 360.0))),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Update Mesh Orientation", inputs: { "Rotation Rate": Vec3((90.0, 45.0, 0.0)) }),
                (module: "Scale Mesh Size", inputs: {
                    "Scale Factor": CurveOverAge(Vec3([(0.0, (0.0, 0.0, 0.0)), (0.2, (1.0, 1.0, 1.0)), (0.8, (1.0, 1.0, 1.0)), (1.0, (0.0, 0.0, 0.0))])),
                }),
            ],
            renderers: [Mesh((mesh: "cube", blend_mode: Opaque, lit: true))],
        ),
    ],
)
