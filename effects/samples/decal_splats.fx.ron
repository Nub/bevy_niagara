// Decal splats: dark-red splats (blood style) appear on the floor, each a
// decal projected straight down onto whatever is below, at a random size
// and turn, and fade out over the last part of their life. A few scorch
// marks (lit, long-lived) sit under them.
(
    name: "Decal Splats",
    emitters: [
        (
            name: "Splats",
            max_particles: 64,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(6), "Spawn Time": Float(0.0) }),
                (module: "Spawn Rate", inputs: { "Spawn Rate": Float(5.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(2.0), Float(3.0)),
                    "Position": RandomRange(Vec3((-1.4, 0.0, -1.0)), Vec3((1.4, 0.0, 1.0))),
                    "Color": RandomRange(Color((0.35, 0.01, 0.01, 0.95)), Color((0.55, 0.03, 0.02, 1.0))),
                }),
                (module: "Initialize Mesh", inputs: {
                    "Mesh Scale": RandomRange(Vec3((0.5, 1.0, 0.5)), Vec3((1.0, 1.0, 1.0))),
                    "Mesh Rotation": RandomRange(Vec3((0.0, 0.0, 0.0)), Vec3((0.0, 360.0, 0.0))),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
            ],
            renderers: [Decal((size: (0.9, 0.4, 0.6), fade_start: 0.6))],
        ),
        (
            name: "Scorch",
            max_particles: 8,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(3), "Spawn Time": Float(0.0) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": Float(8.0),
                    "Position": RandomRange(Vec3((-1.0, 0.0, -0.6)), Vec3((1.0, 0.0, 0.6))),
                    "Color": Color((0.02, 0.018, 0.015, 0.85)),
                }),
                (module: "Initialize Mesh", inputs: {
                    "Mesh Scale": RandomRange(Vec3((1.2, 1.0, 1.2)), Vec3((1.6, 1.0, 1.6))),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
            ],
            renderers: [Decal((size: (1.0, 0.5, 1.0), fade_start: 1.0, lit: true))],
        ),
    ],
)
