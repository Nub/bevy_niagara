// Burst: two instantaneous bursts of sparks flying out in every direction,
// slowing down, shrinking and cooling from white-yellow to red.
(
    name: "Burst",
    emitters: [
        (
            name: "Sparks",
            sim_target: Gpu,
            max_particles: 600,
            emitter_update: [
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(300), "Spawn Time": Float(0.0) }),
                (module: "Spawn Burst Instantaneous", inputs: { "Spawn Count": Int(150), "Spawn Time": Float(0.5) }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(0.6), Float(1.2)),
                    "Position": Vec3((0.0, 1.0, 0.0)),
                    "Color": Color((4.0, 3.0, 1.5, 1.0)),
                    "Sprite Size": Vec2((0.05, 0.05)),
                    "Mass": RandomRange(Float(0.5), Float(1.5)),
                }),
                (module: "Add Velocity in Cone", inputs: {
                    "Cone Angle": Float(180.0),
                    "Velocity Strength": RandomRange(Float(3.0), Float(8.0)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force"),
                (module: "Drag", inputs: { "Drag": Float(2.5) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale RGB": CurveOverAge(Vec3([(0.0, (1.0, 1.0, 1.0)), (0.5, (1.0, 0.4, 0.1)), (1.0, (0.5, 0.05, 0.0))])),
                }),
                (module: "Scale Sprite Size", inputs: {
                    "Scale Factor": CurveOverAge(Vec2([(0.0, (1.0, 1.0)), (1.0, (0.2, 0.2))])),
                }),
            ],
        ),
    ],
)
