// Fountain: a steady upward cone of droplets that falls under gravity and
// fades out. Units are Bevy's: metres, seconds, Y up.
(
    name: "Fountain",
    user_parameters: {
        "User.Gravity": Vec3((0.0, -9.81, 0.0)),
        "User.SpawnRate": Float(200.0),
    },
    emitters: [
        (
            name: "Droplets",
            sim_target: Gpu,
            max_particles: 2000,
            emitter_update: [
                (module: "Spawn Rate", inputs: { "Spawn Rate": Link(Float, "User.SpawnRate") }),
            ],
            particle_spawn: [
                (module: "Initialize Particle", inputs: {
                    "Lifetime": RandomRange(Float(1.5), Float(2.0)),
                    "Color": Color((0.4, 0.7, 1.0, 1.0)),
                    "Sprite Size": RandomRange(Vec2((0.03, 0.03)), Vec2((0.06, 0.06))),
                }),
                (module: "Add Velocity in Cone", inputs: {
                    "Cone Axis": Vec3((0.0, 1.0, 0.0)),
                    "Cone Angle": Float(12.0),
                    "Velocity Strength": RandomRange(Float(6.0), Float(7.5)),
                }),
            ],
            particle_update: [
                (module: "Particle State"),
                (module: "Gravity Force", inputs: { "Gravity": Link(Vec3, "User.Gravity") }),
                (module: "Drag", inputs: { "Drag": Float(0.2) }),
                (module: "Solve Forces and Velocity"),
                (module: "Scale Color", inputs: {
                    "Scale Alpha": CurveOverAge(Float([(0.0, 1.0), (0.7, 1.0), (1.0, 0.0)])),
                }),
            ],
            renderers: [Sprite((blend_mode: Alpha, sort_mode: ViewDepth, soft_particle_fade_distance: 0.2))],
        ),
    ],
)
